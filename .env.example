# API access: set a strong random value; clients send X-API-Key
FINSIGHT_API_KEY=replace-with-long-random-secret
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=openrouter/free
LANGSMITH_API_KEY=replace-me
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=FinSight-RAG
# internal endpoints set in Compose
QDRANT_COLLECTION=finsight_reports_minilm_v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
INDEX_PIPELINE_VERSION=v1
SNOWFLAKE_ACCOUNT=org-account
SNOWFLAKE_USER=service_user
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=FINSIGHT
SNOWFLAKE_SCHEMA=RAG
SNOWFLAKE_ROLE=FINSIGHT_ROLE
SNOWFLAKE_PRIVATE_KEY_FILE=/run/secrets/snowflake_key.p8
# Optional if encrypted:
# SNOWFLAKE_PRIVATE_KEY_PASSWORD=your-passphrase
